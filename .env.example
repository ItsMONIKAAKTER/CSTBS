# Copy to .env; generate a unique secret for your machine.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret
# Optional: default SQLite location is instance/cstbs.db
# DATABASE_URL=sqlite:///cstbs.db

# Development (default): write messages to the application console.
MAIL_BACKEND=console
MAIL_DEFAULT_SENDER=CSTBS <no-reply@campus.example>

# Ethereal SMTP (set MAIL_BACKEND=smtp, then configure your test inbox):
# MAIL_BACKEND=smtp
# MAIL_SERVER=smtp.ethereal.email
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=your-ethereal-user
# MAIL_PASSWORD=your-ethereal-password
# MAIL_SUPPRESS_SEND=false
