# CSTBS V5.1: Copy to .env, generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret
APP_ENV=development
# DATABASE_URL=sqlite:///cstbs.db
SESSION_COOKIE_SECURE=false
# Trusted hostnames are REQUIRED if APP_ENV=production.
# TRUSTED_HOSTS=stadium.example.edu
# memory:// is only suitable for one-process development; use Redis in production.
RATELIMIT_STORAGE_URI=memory://

# Local preview mode - email body is written to application log.
MAIL_BACKEND=console
MAIL_DEFAULT_SENDER=CSTBS <no-reply@campus.example>
# SMTP for development (Ethereal) or a configured production provider:
# MAIL_BACKEND=smtp
# MAIL_SERVER=smtp.ethereal.email
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=your-smtp-user
# MAIL_PASSWORD=your-smtp-password
# MAIL_SUPPRESS_SEND=false

# Optional for local-only `flask seed-demo`; NEVER commit or use on production.
# DEMO_SEED_PASSWORD=generate-a-long-unique-test-password

# V5.1: first local admin key is printed in terminal at startup (valid 60 min).
# Production: use `flask reset-bootstrap-key` from a private operator terminal.
# No payment service or currency credentials are required; university admission is free (CNY).
