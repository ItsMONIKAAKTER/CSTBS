# Optional in local development: CSTBS creates a stable instance/.local_secret_key
# automatically if SECRET_KEY is missing. Do NOT commit local secrets.
# Production MUST configure a strong SECRET_KEY (32+ characters).
# SECRET_KEY=your-strong-generated-production-secret
APP_ENV=development
SESSION_COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
MAIL_BACKEND=console
MAIL_DEFAULT_SENDER=CSTBS <no-reply@campus.example>
# Optional: use a trusted SMTP relay for real notifications.
# MAIL_BACKEND=smtp
# MAIL_SERVER=smtp.ethereal.email
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
# Production: TRUSTED_HOSTS, HTTPS, Redis rate-limit storage, real SMTP.
